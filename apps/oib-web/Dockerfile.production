FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS build

WORKDIR /workspace

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/oib-web/package.json apps/oib-web/package.json
RUN pnpm install --frozen-lockfile --filter @dbix/oib-web...

COPY apps/oib-web apps/oib-web

RUN pnpm --filter @dbix/oib-web build

FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6 AS runtime

ARG SOURCE_REPOSITORY="https://github.com/Nittoors/dibx.oib"
ARG SOURCE_REVISION="uncommitted-local"
LABEL org.opencontainers.image.source="$SOURCE_REPOSITORY" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.title="DIBX OIB Readiness web"

USER root
RUN apk upgrade --no-cache
USER 101

COPY apps/oib-web/nginx.production.conf /etc/nginx/conf.d/default.conf
COPY apps/oib-web/runtime-config.template.js /opt/oib/runtime-config.template.js
COPY --chmod=755 apps/oib-web/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --chown=101:101 --from=build /workspace/apps/oib-web/dist /usr/share/nginx/html/OIBReadiness

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["wget", "-qO-", "http://127.0.0.1:8080/healthz"]

CMD ["nginx", "-g", "daemon off;"]
