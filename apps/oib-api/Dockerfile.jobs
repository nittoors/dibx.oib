FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ARG SOURCE_REPOSITORY="https://github.com/Nittoors/dibx.oib"
ARG SOURCE_REVISION="uncommitted-local"
LABEL org.opencontainers.image.source="$SOURCE_REPOSITORY" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.title="DIBX OIB Readiness database jobs"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/service

WORKDIR /service

COPY apps/oib-api/requirements.lock ./requirements.lock
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --no-deps --requirement requirements.lock \
    && python -m pip check \
    && useradd --create-home --uid 10001 oib

COPY apps/oib-api/app ./app
COPY apps/oib-api/migrations ./migrations
COPY apps/oib-api/alembic.ini ./alembic.ini
COPY data/oib ./data/oib
COPY docs/oib-source/baseline-kpis.json ./baseline-kpis.json

USER oib

CMD ["python", "-m", "app.seed", "--help"]
